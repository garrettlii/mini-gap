<!--
  Mini-GaP workcell. Lives next to Menagerie's panda.xml so mesh paths resolve.
  Coordinates: robot base at the origin, tabletop surface at z = 0, +x points
  away from the robot. Units are meters, kilograms, radians.

  Things added in Python (gap/sim/model_builder.py), because they attach to
  bodies defined inside panda.xml:
    - site "tcp" on the hand (tool center point, between the fingertips)
    - camera "wrist" on the hand
-->
<mujoco model="mini_gap_workcell">
  <include file="panda.xml"/>

  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <global azimuth="150" elevation="-25" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="table_mat" rgba="0.55 0.45 0.35 1"/>
  </asset>

  <default>
    <default class="cube">
      <!-- friction: sliding, torsional, rolling. condim 4 adds torsional friction,
           which keeps cubes from spinning out of the grasp. -->
      <geom type="box" size="0.02 0.02 0.02" mass="0.05" friction="1.5 0.02 0.0005"
        condim="4" solref="0.01 1" priority="1"/>
    </default>
    <default class="zone">
      <geom type="box" size="0.07 0.07 0.0005" contype="0" conaffinity="0" group="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.5 0 1.5" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.75" material="floor_mat"/>

    <!-- Tabletop: top surface at z = 0. The robot base sits on it. -->
    <geom name="table" type="box" size="0.6 0.7 0.02" pos="0.35 0 -0.02" material="table_mat"/>

    <!-- Objects. Poses here are defaults; reset() overwrites them per task instance. -->
    <body name="red_cube" pos="0.5 0 0.02">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube_geom" class="cube" rgba="0.85 0.15 0.15 1"/>
    </body>
    <body name="green_cube" pos="0.5 0.1 0.02">
      <freejoint name="green_cube_joint"/>
      <geom name="green_cube_geom" class="cube" rgba="0.15 0.7 0.2 1"/>
    </body>
    <body name="blue_cube" pos="0.5 -0.1 0.02">
      <freejoint name="blue_cube_joint"/>
      <geom name="blue_cube_geom" class="cube" rgba="0.15 0.3 0.85 1"/>
    </body>

    <!-- Target zones: flat, non-colliding markers plus sites for success checks. -->
    <geom name="zone_a_geom" class="zone" pos="0.4 0.3 0" rgba="0.9 0.9 0.2 0.5"/>
    <site name="zone_a" pos="0.4 0.3 0" type="box" size="0.07 0.07 0.0005" rgba="0 0 0 0"/>
    <geom name="zone_b_geom" class="zone" pos="0.4 -0.3 0" rgba="0.2 0.9 0.9 0.5"/>
    <site name="zone_b" pos="0.4 -0.3 0" type="box" size="0.07 0.07 0.0005" rgba="0 0 0 0"/>

    <!-- Cameras. A camera looks along its own -z axis. The overhead view is
         occluded by the arm in the home pose: perception skills should first move
         the arm to a camera-clear pose (GaP stages its cameras the same way). -->
    <camera name="overhead" pos="0.45 0 1.1" xyaxes="0 -1 0 1 0 0" fovy="60"/>
    <camera name="front" pos="1.15 0 0.55" xyaxes="0 1 0 -0.61 0 0.79" fovy="50"/>
  </worldbody>
</mujoco>
